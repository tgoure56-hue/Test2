# ============================================================================
#  Configuration de l'experience "1$ a des inconnus"
#  Copie ce fichier en .env et remplis les valeurs. NE COMMIT JAMAIS .env.
# ============================================================================

# --- Rendu video -----------------------------------------------------------
# Chemin du navigateur Chromium pour Remotion.
# EN LOCAL : laisse vide, Remotion telechargera son propre navigateur.
# SUR CE SERVEUR : /opt/pw-browsers/chromium_headless_shell-1194/chrome-linux/headless_shell
CHROMIUM_PATH=

# --- PayPal (recuperation automatique du total) ----------------------------
# https://developer.paypal.com -> cree une app REST -> active "Transaction Search".
PAYPAL_CLIENT_ID=
PAYPAL_SECRET=
PAYPAL_ENV=live
# Date de debut de l'experience (cumul du total a partir de cette date).
EXPERIMENT_START_DATE=2026-07-09
# Optionnel : ne compter que cette devise (USD, EUR...). Vide = toutes.
CURRENCY=USD
# Mettre a 1 pour ignorer PayPal et garder le total ecrit dans le fichier du jour.
SKIP_PAYPAL=0

# --- YouTube (API Data v3) -------------------------------------------------
# Google Cloud -> active "YouTube Data API v3" -> identifiants OAuth 2.0.
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REFRESH_TOKEN=

# --- TikTok (Content Posting API) ------------------------------------------
# https://developers.tiktok.com -> app + scope video.publish.
TIKTOK_ACCESS_TOKEN=
# SELF_ONLY (obligatoire tant que l'app n'est pas auditee) ou PUBLIC_TO_EVERYONE.
TIKTOK_PRIVACY_LEVEL=SELF_ONLY

# --- Instagram (Graph API) -------------------------------------------------
# Compte PRO relie a une Page Facebook + app Meta avec instagram_content_publish.
IG_USER_ID=
IG_ACCESS_TOKEN=
IG_API_VERSION=v21.0
# URL HTTPS PUBLIQUE ou la video du jour est hebergee (requis par Instagram).
VIDEO_PUBLIC_URL=

# --- Selection des plateformes ---------------------------------------------
# Laisse par defaut pour publier partout, ou restreins : ex "youtube,tiktok".
PUBLISH_TARGETS=youtube,tiktok,instagram
